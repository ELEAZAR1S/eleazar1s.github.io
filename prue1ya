<!-- ═══ SCRIPT DE DESVANECIMIENTO AL SCROLL ═══ -->
<script>
  window.addEventListener('scroll', function() {
    const heroBg = document.getElementById('heroBg');
    const heroOverlay = document.getElementById('heroOverlay');
    if (!heroBg) return;
    
    const scrollPosition = window.scrollY;
    const windowHeight = window.innerHeight;

    if (scrollPosition <= windowHeight) {
      let opacity = 1 - (scrollPosition / (windowHeight * 0.75));
      heroBg.style.opacity = Math.max(opacity, 0);
      if (heroOverlay) heroOverlay.style.opacity = Math.max(opacity, 0);
    } else {
      heroBg.style.opacity = 0;
      if (heroOverlay) heroOverlay.style.opacity = 0;
    }
  });
</script>

